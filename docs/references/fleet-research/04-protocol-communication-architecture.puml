@startuml Protocol Communication Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

title Protocol Communication Architecture

package "Frontend" {
    component "Agent UI" as UI
    component "Agent Request API" as RequestAPI
    component "Agent Response Handler" as ResponseHandler
}

package "Protocols" {
    component "ACP" as ACP
    component "MCP" as MCP
    component "Claude Protocol" as Claude
    component "Protocol Router" as Router
}

package "Message Types" {
    component "AgentRequest" as AgentReq
    component "ClientResponse" as ClientResp
    component "ToolCall" as ToolCall
    component "ToolResult" as ToolResult
    component "Notification" as Notification
}

package "External Systems" {
    component "Terminal" as Terminal
    component "File System" as FileSystem
    component "External Tools" as ExtTools
    component "LLM Provider" as LLM
}

' ACP Protocol Flow
UI --> RequestAPI : "User Request"
RequestAPI --> ACP : "AgentRequest"
ACP --> AgentReq : "Create Request"
AgentReq --> Terminal : "Terminal Operation"
AgentReq --> FileSystem : "File Operation"
Terminal --> ClientResp : "Terminal Output"
FileSystem --> ClientResp : "File Response"
ClientResp --> ResponseHandler : "Handle Response"
ResponseHandler --> UI : "Update UI"

' MCP Protocol Flow
UI --> MCP : "Tool Request"
MCP --> ExtTools : "Execute Tool"
ExtTools --> ToolResult : "Tool Result"
ToolResult --> MCP : "Result Response"
MCP --> ResponseHandler : "Handle Result"
ResponseHandler --> UI : "Update UI"

' Claude Protocol Flow
UI --> Claude : "Claude Request"
Claude --> ToolCall : "Tool Invocation"
ToolCall --> Claude : "Tool Request"
Claude --> LLM : "API Call"
LLM --> ToolResult : "Model Response"
ToolResult --> Claude : "Result"
Claude --> AgentReq : "Agent Response"
AgentReq --> ResponseHandler : "Handle"
ResponseHandler --> UI : "Update UI"

' Protocol Routing
RequestAPI --> Router : "Route Request"
Router --> ACP : "ACP Request"
Router --> MCP : "MCP Request"
Router --> Claude : "Claude Request"

' Message Flow
AgentReq --> Notification : "Request Notification"
Notification --> ResponseHandler : "Handle Notification"
ClientResp --> Notification : "Response Notification"

' Error Handling
ACP --> ResponseHandler : "Error Response"
MCP --> ResponseHandler : "Error Response"
Claude --> ResponseHandler : "Error Response"

legend right
  = Frontend Components
  = Communication Protocols
  = Message Types
  = External Systems
endlegend

@enduml
