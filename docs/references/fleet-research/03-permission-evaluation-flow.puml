@startuml Permission Evaluation Flow

!theme plain
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

title Permission Evaluation Flow

package "Permission System" {
    component "AgentPermissionHolder" as AgentPerm
    component "AccessKey" as AccessKey
    component "AccessType" as AccessType
    component "Trust Mode" as TrustMode
}

package "Tools & Operations" {
    component "Terminal Tool" as Terminal
    component "Web Search Tool" as WebSearch
    component "File Tool" as FileTool
    component "Custom Tool" as CustomTool
}

package "Permission States" {
    component "Trusted Mode" as Trusted
    component "Untrusted Mode" as Untrusted
    component "Auto-run" as Auto
    component "Manual Approval" as Manual
}

package "User Interaction" {
    component "Permission Dialog" as Dialog
    component "User Decision" as User
}

' Trust mode check
TrustMode --> AgentPerm : "Check trusted flag"

' Permission flow for tools
Terminal --> AccessKey : "Terminal Permission"
WebSearch --> AccessKey : "Web Permission"
FileTool --> AccessKey : "File Permission"
CustomTool --> AccessKey : "Custom Permission"

AccessKey --> AccessType : "Hierarchy Traversal"
AccessType --> AgentPerm : "Permission State"

' Permission evaluation
AccessType --> Trusted : "Auto-allow if trusted"
AccessType --> Untrusted : "Check parent permissions"
AccessType --> Dialog : "Show permission dialog"

' Trust mode flows
Trusted --> Auto : "Auto-run enabled"
Untrusted --> Manual : "Manual approval required"

' Tool execution flows
Auto --> Terminal : "Execute immediately"
Manual --> Dialog : "Show approval dialog"
Dialog --> User : "User decision"
User --> Auto : "Allow - Execute"
User --> Untrusted : "Deny - Block"

' Permission checking cycle
AccessKey --> AccessType : "Cycle Detection"
AccessType --> AccessKey : "No Circular Ref"

' Permission storage
AgentPerm --> AccessType : "Persistence"
AccessType --> Dialog : "Permission Updates"

legend right
  = Core Permission Components
  = Tools and Operations
  = Permission States
  = User Interaction
endlegend

@enduml
