{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coder",
  "version": "0.1.0",
  "identifier": "com.coder.app",
  "build": {
    "frontendDist": "../src-ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../src-ui run dev",
    "beforeBuildCommand": "npm --prefix ../src-ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Coder",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2b.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
